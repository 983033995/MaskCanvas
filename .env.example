# Optional local/private ComfyUI image endpoint. No public/cloud endpoint here.
COMFYUI_IMAGE_SERVER_URL=http://100.123.176.90:8188
# The server stores photos in ./projects by default (gitignored).
# MASKCANVAS_DATA_DIR=/absolute/path/to/local/projects
# MCP connects to the running local server; it does not start a second store.
MASKCANVAS_URL=http://127.0.0.1:7317
# Trusted identity for this MCP connection. Must match a project analysis grant.
MASKCANVAS_AGENT_CLIENT=client:external-agent
# GPT execution is OFF by default. Node schema discovery is not authorization.
MASKCANVAS_ALLOW_REMOTE_GENERATION=0
# If explicitly enabled, this MUST equal the ComfyUI upload origin above.
# It identifies the forwarding node, not an independently verified cloud origin.
# MASKCANVAS_GPT_DESTINATION=http://100.123.176.90:8188
MASKCANVAS_GPT_MODEL=gpt-image-2.5-flare
